{
  "enabled": true,
  "label": "alternative-reviewer:claude-code",
  "command": [
    "claude",
    "-p",
    "--output-format",
    "stream-json",
    "--include-hook-events",
    "--include-partial-messages",
    "--no-session-persistence",
    "--permission-mode",
    "bypassPermissions",
    "--tools",
    "Bash,Read"
  ],
  "output_format": "claude_stream_json",
  "env_unset": [
    "ANTHROPIC_API_KEY"
  ],
  "pre_run_health": true,
  "credential_identity_source": "claude_secure_storage",
  "health_command": [
    "claude",
    "auth",
    "status",
    "--json"
  ]
}
