{
  "enabled": true,
  "label": "alternative-reviewer:oh-my-pi",
  "command": [
    "omp",
    "-p",
    "--mode",
    "json",
    "--no-session",
    "--no-extensions",
    "--auto-approve",
    "--thinking",
    "xhigh"
  ],
  "prompt_delivery": "argv_positional_prompt_file_reference",
  "run_directory_grant_flag": "--add-dir",
  "output_format": "oh_my_pi_json",
  "env_unset": [
    "PI_SMOL_MODEL",
    "PI_SLOW_MODEL",
    "PI_PLAN_MODEL",
    "PI_CODING_AGENT_DIR",
    "PI_TIMING"
  ],
  "health_command": [
    "omp",
    "-p",
    "--mode",
    "json",
    "--no-session",
    "--no-extensions",
    "--auto-approve",
    "--thinking",
    "xhigh",
    "Reply with exactly: OK"
  ],
  "reviewer_model_selection_source": "oh_my_pi_default_model_role",
  "timeout_seconds": 900
}
