{
  "enabled": true,
  "label": "alternative-reviewer:kimi-code",
  "reviewer_model_selection_source": "kimi_latest_managed_stable_model",
  "command": [
    "kimi",
    "--output-format",
    "stream-json"
  ],
  "prompt_delivery": "argv_prompt_flag_with_prompt_file_pointer",
  "prompt_flag": "-p",
  "run_directory_grant_flag": "--add-dir",
  "output_format": "kimi_stream_json",
  "env_unset": [
    "ANTHROPIC_API_KEY",
    "KIMI_API_KEY",
    "KIMI_BASE_URL",
    "KIMI_MODEL_NAME",
    "KIMI_MODEL_API_KEY",
    "KIMI_MODEL_BASE_URL",
    "KIMI_MODEL_PROVIDER_TYPE",
    "KIMI_MODEL_OUTPUT_FORMAT",
    "KIMI_CODE_BASE_URL",
    "KIMI_CODE_OAUTH_HOST",
    "KIMI_OAUTH_HOST",
    "KIMI_CODE_EXPERIMENTAL_FLAG"
  ],
  "timeout_seconds": 900
}
